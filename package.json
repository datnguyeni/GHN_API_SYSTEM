{
  "name": "ghn-shipping-service",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "mvn -f backend/pom.xml spring-boot:run",
    "demo": "mvn -f backend/pom.xml spring-boot:run -Dspring-boot.run.profiles=demo",
    "test": "mvn -f backend/pom.xml test"
  },
  "engines": { "node": ">=22.18.0" },
  "dependencies": { "react": "19.2.0", "react-dom": "19.2.0" },
  "devDependencies": { "@types/react": "19.2.2", "@types/react-dom": "19.2.2", "typescript": "5.9.3", "vite": "7.2.2" }
}
